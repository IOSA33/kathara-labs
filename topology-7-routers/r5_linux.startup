ip addr add 135.46.52.1/24 dev eth0
ip addr add 192.53.56.1/24 dev eth1
ip addr add 192.168.0.9/30 dev eth2

ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

mkdir -p /var/log/quagga
touch /var/log/quagga/ripd.log
chown -R quagga:quagga /var/log/quagga
chmod 750 /var/log/quagga
chmod 640 /var/log/quagga/ripd.log

/etc/init.d/quagga start
