ip addr add 192.168.0.6/30 dev eth0
ip addr add 192.168.0.25/30 dev eth1
ip addr add 192.168.0.21/30 dev eth2
ip addr add 192.168.0.13/30 dev eth3

ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up

mkdir -p /var/log/quagga
touch /var/log/quagga/ripd.log
chown -R quagga:quagga /var/log/quagga
chmod 750 /var/log/quagga
chmod 640 /var/log/quagga/ripd.log

/etc/init.d/quagga start