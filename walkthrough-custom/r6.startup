ip route add 10.0.10.0/24 via 10.0.3.1
ip route add 10.0.11.0/24 via 10.0.3.1

# through r4
ip route add 10.0.7.0/24  via 10.0.4.2
ip route add 10.0.8.0/24  via 10.0.4.2

# through r5
ip route add 10.0.6.0/24  via 10.0.5.2
ip route add 10.0.12.0/24 via 10.0.5.2
ip route add 10.0.13.0/24 via 10.0.5.2
ip route add 10.0.14.0/24 via 10.0.5.2
